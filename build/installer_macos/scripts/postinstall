#!/bin/bash
# postinstall script for A-Z+T macOS package
# Runs as root after the .pkg installs files.
# Copies Charis SIL fonts from the app bundle to /Library/Fonts.

FONT_SOURCE="/Applications/A-Z+T.app/Contents/Resources/fonts"
FONT_DEST="/Library/Fonts"

if [ -d "$FONT_SOURCE" ]; then
    for font in "$FONT_SOURCE"/*.ttf; do
        [ -f "$font" ] || continue
        fname="$(basename "$font")"
        if [ ! -f "$FONT_DEST/$fname" ]; then
            cp "$font" "$FONT_DEST/" && echo "Installed font: $fname"
        else
            echo "Font already present: $fname"
        fi
    done
    # Clear ATS font cache so fonts are available immediately
    atsutil databases -remove 2>/dev/null || true
fi

exit 0
