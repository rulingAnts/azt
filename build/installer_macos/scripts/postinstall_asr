#!/bin/bash
# postinstall_asr — optional ASR features for A-Z+T
# Runs as root after the ASR component .pkg is installed.
#
# Creates an isolated Python venv at /Library/Application Support/AZT/asr-env/
# and installs PyTorch, Whisper and supporting packages from PyPI.
# The app's asr.py looks for this venv when loading speech recognition features.

set -euo pipefail

ASR_ENV="/Library/Application Support/AZT/asr-env"

# Find a usable Python 3 (prefer 3.12, then 3.11, then whatever is on PATH)
PYTHON=""
for candidate in python3.12 python3.11 python3.10 python3; do
    if command -v "$candidate" &>/dev/null; then
        PYTHON="$(command -v "$candidate")"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "ERROR: No Python 3 found. Install Python 3 from https://www.python.org/" >&2
    exit 1
fi

echo "==> Creating ASR venv at: $ASR_ENV"
"$PYTHON" -m venv "$ASR_ENV"

echo "==> Installing ASR packages (downloading ~4 GB from PyPI)..."
"$ASR_ENV/bin/pip" install --upgrade pip
"$ASR_ENV/bin/pip" install \
    torch \
    openai-whisper \
    transformers \
    "huggingface_hub[hf_xet]"

# Write a small marker file so the app can find this env reliably
echo "$ASR_ENV" > "/Library/Application Support/AZT/asr-env-path.txt"

echo "==> ASR features installed successfully."
exit 0
